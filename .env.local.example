NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# FEAT-001-login: 단일 테넌트 기본값 (lib/supabase/seed.sql과 동일한 UUID)
DEFAULT_TENANT_ID=a0000000-0000-4000-8000-000000000001

# FEAT-003-sales-department: Y-ERP(SMARTE_DB) 읽기 전용 접속 정보
MSSQL_HOST=your_yerp_host
MSSQL_PORT=1433
MSSQL_DATABASE=SMARTE_DB
MSSQL_USER=your_readonly_user
MSSQL_PASSWORD=your_password
